# Скопируйте в .env.local и заполните. Файлы .env*.local не попадают в git.
# Переменные читаются в app.config.ts во время сборки (EAS подставляет env из eas.json).

# development | preview | production
APP_ENV=development

# После `npx eas-cli@latest init` — включает OTA-обновления (expo-updates)
EAS_PROJECT_ID=

# Реальный бэкенд (сейчас приложение работает на встроенном mock-сервере)
API_URL=https://api.silkx.uz

# Ключи Google Maps для production-сборок Android/iOS (в Expo Go не нужны)
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# Наблюдаемость
SENTRY_DSN=
ANALYTICS_KEY=
